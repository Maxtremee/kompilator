{
	"name": "kompilator",
	"version": "0.1.0",
	"scripts": {
		"build": "nest build",
		"check:fix": "biome check --write",
		"check": "biome check",
		"clean": "rm -rf node_modules pnpm-lock.yaml dist",
		"dev": "nest start --watch",
		"format": "pnpm biome format --write",
		"lint": "biome lint",
		"migration:generate": "pnpm run typeorm migration:generate -d ./dist/src/db/datasource.js ./src/db/migrations/$NAME",
		"migration:revert": "pnpm run typeorm migration:revert -d ./dist/src/db/datasource.js",
		"migration:run": "pnpm run typeorm migration:run -d ./dist/src/db/datasource.js",
		"nest": "nest",
		"start:debug": "nest start --debug --watch",
		"start:prod": "pnpm run typeorm migration:run -d ./dist/db/datasource.js && node dist/main",
		"start": "nest start",
		"test:cov": "jest --coverage",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"test:watch": "jest --watch",
		"test": "jest",
		"typecheck": "tsc --noEmit",
		"typeorm": "rm -rf ./dist && tsc && pnpx typeorm"
	},
	"dependencies": {
		"@bull-board/api": "6.9.1",
		"@bull-board/express": "6.9.1",
		"@bull-board/nestjs": "6.9.1",
		"@discordjs/formatters": "0.6.1",
		"@nestjs/bullmq": "11.0.2",
		"@nestjs/common": "11.1.1",
		"@nestjs/config": "4.0.2",
		"@nestjs/core": "11.1.1",
		"@nestjs/platform-express": "11.1.1",
		"@nestjs/schedule": "6.0.0",
		"@nestjs/serve-static": "5.0.3",
		"@nestjs/typeorm": "11.0.0",
		"@t3-oss/env-core": "^0.11.1",
		"axios": "1.9.0",
		"bullmq": "5.49.0",
		"discord.js": "14.19.3",
		"dotenv": "16.5.0",
		"exponential-backoff": "3.1.2",
		"fluent-ffmpeg": "2.1.3",
		"minio": "8.0.5",
		"necord": "6.8.13",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"sqlite3": "5.1.7",
		"typeorm": "0.3.24",
		"zod": "3.24.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@necord/schematics": "1.3.7",
		"@nestjs/cli": "11.0.7",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/express": "^5.0.0",
		"@types/fluent-ffmpeg": "^2.1.26",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"@types/supertest": "^6.0.2",
		"globals": "^16.0.0",
		"jest": "^29.7.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "5.8.3"
	},
	"pnpm": {
		"ignoredBuiltDependencies": ["msgpackr-extract"],
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@nestjs/core",
			"@swc/core",
			"sqlite3"
		]
	}
}
